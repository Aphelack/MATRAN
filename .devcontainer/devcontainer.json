{
  "name": "Swift Parser & Interpreter in F#",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "features": {
    "ghcr.io/devcontainers/features/dotnet:2": {
      "version": "9.0"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.11"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        // F# Development
        "ionide.ionide-fsharp",
        "ms-dotnettools.csharp",
        
        // AI & Productivity
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "GitHub.vscode-pull-request-github",
        
        // Parsing & Language Tools
        "josefpihrt-vscode.roslynator",
        "ms-dotnettools.vscode-dotnet-runtime",
        "tintoy.msbuild-project-tools",
        
        // Visualization & Debugging
        "hediet.vscode-drawio",
        "hediet.debug-visualizer",
        
        // Utilities
        "ms-vsliveshare.vsliveshare",
        "eamodio.gitlens",
        "visualstudioexptteam.vscodeintellicode"
      ],
      
      "settings": {
        // F# Settings
        "FSharp.inlayHints.typeAnnotations": true,
        "FSharp.inlayHints.parameterNames": "all",
        "FSharp.verboseLogging": false,
        "FSharp.fsac.netCoreDllFlag": "--use-sdk-refs",
        
        // Editor Settings
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
          "source.fixAll": "explicit"
        },
        "files.autoSave": "afterDelay",
        
        // Copilot Settings
        "github.copilot.enable": {
          "*": true,
          "plaintext": true,
          "markdown": true
        },
        "github.copilot-chat.codeGeneration.instructions": [
          {
            "file": "**/*.fs",
            "instruction": "You are an expert in F#, parsing, compilers, and interpreter design. Write idiomatic F# with functional patterns, immutable data structures, and proper error handling."
          }
        ]
      }
    }
  },

  // Swift-specific tools
  "postCreateCommand": "apt-get update && apt-get install -y clang libicu-dev libxml2-dev && dotnet tool install -g dotnet-script && echo 'Environment ready!'",

  // Mounts for caching
  "mounts": [
    "source=swift-interpreter-nuget,target=/root/.nuget,type=volume",
    "source=swift-interpreter-npm,target=/root/.npm,type=volume",
    "source=swift-interpreter-cache,target=/root/.cache,type=volume"
  ],

  // Container configuration
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  
  // Ports for visualization tools
  "portsAttributes": {
    "8080": {
      "label": "Visualizer",
      "onAutoForward": "openPreview"
    },
    "5000": {
      "label": "REPL/API",
      "onAutoForward": "notify"
    }
  },

  // Workspace folder
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  
  // Forward git config
  "remoteEnv": {
    "GIT_EDITOR": "code --wait"
  }
}